{
  "manifest_version": 3,
  "name": "LumaBloom – Ambient Glow",
  "version": "1.0.0",
  "description": "Cinematic, video-synced ambient lighting for YouTube™ — processed privately on your device.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LumaBloom",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["ambient.css"], "run_at": "document_idle"}]
}
